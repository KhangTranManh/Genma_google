+    '                    patternIndex += 1\n',
+    '            result.append(data)\n',
+    '            return "".join(result)\n',
+    '        return data\n'
+]
+
+# Find where the old logic ends
+end_line = -1
+for i in range(start_line, len(lines)):
+    if 'return "".join(result)' in lines[i]:
+        end_line = i
