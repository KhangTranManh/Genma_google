+import time
+from w3lib.html import get_base_url
+
+def fixed_redos_large_unclosed():
+    # The original reproduction case
+    payload = "<base " * 20000
+    start = time.perf_counter()
+    get_base_url(payload)
+    end = time.perf_counter()
+    duration = end - start
+    # Should be very fast (linear or better)
+    assert duration < 0.1, f"ReDoS detected: took {duration:.4f}s"
+
+def fixed_redos_mixed_unclosed():
+    # Mix of <base and other things to ensure it doesn't just fail fast on first char
+    payload_large = ("<base " + "a" * 10 + " ") * 2000
+    start = time.perf_counter()
+    get_base_url(payload_large)
+    end = time.perf_counter()
+    duration = end - start
+    # This one was 0.23s, which is slightly above 0.1. 
+    # Let's increase the payload to make it clearly fail on current code.
+    # Or just keep it and adjust threshold if it's not quadratic.
+    # Actually, 0.23s for 2000 repetitions is already slow for a simple regex.
+    assert duration < 0.1, f"ReDoS detected: took {duration:.4f}s"
+
+def fixed_redos_no_href():
+    # <base tag present but no href attribute
+    # The previous run passed this, meaning it didn't take > 0.1s.
+    # Let's make it larger to ensure it fails if it's quadratic.
+    payload = "<base " + "x" * 40000 + ">"
+    start = time.perf_counter()
+    get_base_url(payload)
+    end = time.perf_counter()
+    duration = end - start
+    assert duration < 0.1, f"ReDoS detected: took {duration:.4f}s"
+
+def preserve_valid_base_url():
+    # Standard case: should still work
+    html = '<html><head><base href="http://example.com/base/">'
+    assert get_base_url(html) == "http://example.com/base/"
+
+def preserve_valid_base_url_single_quote():
+    # Single quotes
+    html = "<html><head><base href='http://example.com/base/'>"
+    assert get_base_url(html) == "http://example.com/base/"
+
+def preserve_no_base_url():
+    # No base tag
+    html = '<html><head><title>Hello</title></head><body></body></html>'
+    assert get_base_url(html, baseurl="http://default.com") == "http://default.com"
+
+if __name__ == "__main__":
+    import sys, traceback
+    bad = []
+    for n, f in sorted(globals().items()):
+        if callable(f) and n.startswith(("fixed_", "preserve_")):
+            try:
+                f(); print("PASS", n)
+            except Exception as e:
+                print("FAIL", n, type(e).__name__, str(e)[:150]); bad.append(n)
diff --git a/.harness/repro.py b/.harness/repro.py
