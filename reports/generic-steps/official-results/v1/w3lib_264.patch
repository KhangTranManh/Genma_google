+++ b/.harness/repro.py
@@ -0,0 +1,65 @@
+import time
+import re
+from w3lib.html import get_base_url
+
+def test_redos():
+    # The regex is: r"<base\s[^>]*href\s*=\s*[\"']\s*([^\"'\s]+)\s*[\"']"
+    # The vulnerability is in <base\s[^>]*
+    # If we have many <base followed by something that is NOT '>', 
+    # and the regex engine tries to find 'href' but fails, it might backtrack.
+    # However, [^>]* is greedy and doesn't overlap with <base\s.
+    
+    # Let's try a more classic ReDoS pattern: (a+)+b
+    # Here we have <base\s[^>]*href
+    # If we have <base <base <base ... and no href, and no >, 
+    # the first <base\s will match, then [^>]* will consume everything.
+    # If it doesn't find 'href', it will backtrack.
+    # But [^>]* is just a character class, it doesn't have nested quantifiers.
+    
+    # Wait, the issue says: "triggers quadratic complexity on inputs with multiple unclosed <base tags"
+    # If we have "<base <base <base <base ...", the first <base\s matches.
+    # Then [^>]* matches everything. Then it looks for 'href'.
+    # If 'href' is not there, it fails.
+    # Then the regex engine might try to start the match from the SECOND <base\s.
+    # This is exactly where the quadratic behavior comes from:
+    # For a string of length N, it tries to match at index 0, then index 1, ..., index N.
+    # At each index, it might scan the rest of the string.
+    
+    # Let's try a long string of "<base "
+    payload = "<base " * 10000
+    
+    start = time.perf_counter()
+    get_base_url(payload)
+    end = time.perf_counter()
+    
+    duration = end - start
+    print(f"Duration for 10k <base: {duration:.4f}s")
+    
+    # For 10k, if it's O(N^2), it might be slow.
+    # Let's try 20k.
+    payload_20k = "<base " * 20000
+    start = time.perf_counter()
+    get_base_url(payload_20k)
+    end = time.perf_counter()
+    duration_20k = end - start
+    print(f"Duration for 20k <base: {duration_20k:.4f}s")
+    
+    # If it's O(N^2), duration_20k should be ~4x duration.
+    # But the real issue is when it's REALLY slow.
+    # Let's use a larger input and a strict threshold.
+    
+    # If the fix is [^<>]* instead of [^>]*, then <base <base will fail faster
+    # because the second < will stop the [^<>]* match.
+    
+    assert duration_20k < 0.1, f"ReDoS detected: took {duration_20k:.4f}s"
+
+if __name__ == "__main__":
+    try:
+        test_redos()
+        print("No ReDoS observed")
+    except AssertionError as e:
+        print(e)
+        exit(1)
+    except Exception as e:
+        print(f"Unexpected error: {e}")
+        exit(1)
