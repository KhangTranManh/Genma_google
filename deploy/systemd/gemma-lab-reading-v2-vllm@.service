[Unit]
Description=Gemma Lab vLLM model %i
After=network.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@PROJECT_ROOT@/.venv/bin/gemma-lab --config @PROJECT_ROOT@/configs/reading-runtime-v2.toml serve --model %i
Environment=PYTHONUNBUFFERED=1
Restart=no
TimeoutStopSec=45
KillMode=control-group
StandardOutput=append:@PROJECT_ROOT@/runs/vllm-reading-v2-%i.log
StandardError=inherit
