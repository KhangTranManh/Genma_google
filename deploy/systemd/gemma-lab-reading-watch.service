[Unit]
Description=Read-only focused-reading progress observation
[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@PROJECT_ROOT@/.venv/bin/python @PROJECT_ROOT@/scripts/official/reading_watch.py
TimeoutStartSec=45s
StandardOutput=append:@PROJECT_ROOT@/runs/reading-v1/watch.log
StandardError=inherit
